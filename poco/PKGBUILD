pkgname="carbonio-poco"
pkgver="1.14.1" # renovate: datasource=github-tags depName=pocoproject/poco
pkgrel="1"
pkgdesc="C++ class libraries for network-centric, portable applications, complete edition with debug libraries"
maintainer="Zextras <packages@zextras.com>"
url="https://zextras.com"
section="mail"
priority="optional"
arch=('x86_64')
depends__apt=(
  "carbonio-openssl"
)
makedepends__apt=(
  "autoconf"
  "carbonio-openssl"
  "cmake"
  "ninja-build"
  "unixodbc-dev"
)
depends__yum=(
  "carbonio-openssl"
)
makedepends__yum=(
  "carbonio-openssl"
  "cmake"
  "expat-devel"
  "gcc-c++"
  "libtool-ltdl-devel"
  "libuv-devel"
  "make"
  "ninja-build"
  "pcre-devel"
  "platform-python-devel"
  "zlib-devel"
)
source=("https://github.com/pocoproject/poco/archive/refs/tags/poco-${pkgver}-release.tar.gz")
sha256sums=('e711712d68d01e580be315e1cca21d2d10ce941fc3252c0402c0a5732f719445')

build() {
  cd "${srcdir}/poco-poco-${pkgver}-release"
  export CFLAGS="-I/opt/zextras/common/include $CFLAGS"
  export LDFLAGS="-Wl,-rpath,/opt/zextras/common/lib -L/opt/zextras/common/lib $LDFLAGS"

  cmake \
    -GNinja \
    -Bbuild \
    -DENABLE_TESTS=OFF \
    -DENABLE_MONGODB=OFF \
    -DENABLE_ACTIVERECORD=OFF \
    -DENABLE_DATA=OFF \
    -DENABLE_DATA_MYSQL=OFF \
    -DENABLE_DATA_ODBC=OFF \
    -DENABLE_DATA_POSTGRESQL=OFF \
    -DENABLE_DATA_SQLITE=OFF \
    -DENABLE_APACHECONNECTOR=OFF \
    -DENABLE_REDIS=OFF \
    -DENABLE_ZIP=OFF \
    -DCMAKE_INSTALL_PREFIX="/opt/zextras/common" \
    -DCMAKE_BUILD_TYPE=Release .

  ninja -C build -j 8
}

package() {
  cd "${srcdir}/poco-poco-${pkgver}-release"

  DESTDIR="${pkgdir}" ninja -C build install
}
