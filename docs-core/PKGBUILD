source=(
  "https://github.com/LibreOffice/core/archive/cp-${pkgver}-${_pkgrel}.tar.gz"
  "libreoffice-dictionaries-${pkgver}.tar.gz::https://github.com/LibreOffice/dictionaries/archive/cp-${pkgver}-${_pkgrel}.tar.gz"
  "libreoffice-help-${pkgver}.tar.gz::https://github.com/LibreOffice/help/archive/cp-${pkgver}-${_pkgrel}.tar.gz"
  "libreoffice-translations-${pkgver}.tar.gz::https://github.com/LibreOffice/translations/archive/cp-${pkgver}-${_pkgrel}.tar.gz"
  "make-pyuno-work-with-system-wide-module-install.diff"
  "openoffice.lst.in.append"
)
# The dictionaries/help/translations tarballs are kept as downloaded archives
# (not unpacked) so prepare() can place them into external/tarballs/ under the
# names LO's get-submodules expects, avoiding network access at build time.
noextract=(
  "libreoffice-dictionaries-${pkgver}.tar.gz"
  "libreoffice-help-${pkgver}.tar.gz"
  "libreoffice-translations-${pkgver}.tar.gz"
)
sha256sums=(
  '9915643e78dab20763f2085b1aa8418c6254ebb4aed337e6475d9c8ceee6ff48'
  'SKIP'
  'SKIP'
  'SKIP'
  '9f151e6e23ce75da475a2922ca091853e712f28da694b1d90d952b1290a6d846'
  '98f41a0f9cda7bfbee46dfb78fcc12331404276f4bdf7763e090dd9b0d524076'
)

prepare() {
  cd "${srcdir}/core-cp-${pkgver}-${_pkgrel}"

  if [ ! -d external/tarballs ]; then
    mkdir external/tarballs/

    # Copy the noextract source tarballs in with the names the Makefile's
    # get-submodules expects (*.tar.xz, no patch release). This way
    # fetch_Download_item_unchecked finds the file and skips the download from
    # download.documentfoundation.org (which 404s for Collabora fork versions).
    # tar auto-detects compression, so the .tar.xz extension works despite being .tar.gz content.
    cp "${srcdir}/libreoffice-dictionaries-${pkgver}.tar.gz" \
      "external/tarballs/libreoffice-dictionaries-${pkgver}.tar.xz"
    cp "${srcdir}/libreoffice-help-${pkgver}.tar.gz" \
      "external/tarballs/libreoffice-help-${pkgver}.tar.xz"
    cp "${srcdir}/libreoffice-translations-${pkgver}.tar.gz" \
      "external/tarballs/libreoffice-translations-${pkgver}.tar.xz"
  fi

  tar xf "external/tarballs/libreoffice-dictionaries-${pkgver}.tar.xz" \
    --directory=dictionaries \
    --strip-components 1
  tar xf "external/tarballs/libreoffice-help-${pkgver}.tar.xz" \
    --directory=helpcontent2 \
    --strip-components 1
  tar xf "external/tarballs/libreoffice-translations-${pkgver}.tar.xz" \
    --directory=translations \
    --strip-components 1

  # Rocky/RHEL 8.10 silently rebuilt the default llvm-toolset:rhel8 module
  # stream (May 2026) to ship llvm-21 instead of llvm-17. llvm-21 drags
  # python3.12, which registers /usr/bin/python3 at a higher alternatives
  # priority than platform-python 3.6. The python3-lxml / python3-polib
  # packages bind to 3.6 only, so configure's AC_PYTHON check fails with
  # "lxml for python3 is needed". Restore python3 -> platform-python so the
  # configure macro finds the modules that are actually installed.
  if [ -x /usr/libexec/platform-python ] && command -v alternatives >/dev/null 2>&1; then
    # platform-python isn't registered as an alternative by default on Rocky
    # 8.10; --install first, then force-select it over python3.12.
    alternatives --install /usr/bin/python3 python3 \
      /usr/libexec/platform-python 99999 2>/dev/null || true
    alternatives --set python3 /usr/libexec/platform-python 2>/dev/null || true
  fi

  # fix not upstreamable pyuno paths - FS#54250
  patch -Np1 -i ../make-pyuno-work-with-system-wide-module-install.diff
  cat ../openoffice.lst.in.append >>instsetoo_native/util/openoffice.lst.in

  sed -i "s/: check-if-root/:/" Makefile.in
}

build() {
  cd "${srcdir}/core-cp-${pkgver}-${_pkgrel}"

  # Cross-compilation support (yap sets CROSS_COMPILE / CROSS_COMPILE_HOST when
  # invoked with -t <arch>). LibreOffice/core builds host-run tools mid-build,
  # so configure needs both --build and --host; the gcc cross toolchain is used
  # for the target while CC_FOR_BUILD (set by yap) stays native for build tools.
  #
  # System libs (carbonio-curl/-icu/-libxml2/-openssl) live under /opt/zextras/common;
  # LO's --with-system-* resolves them through pkg-config.
  export CPPFLAGS="-I/opt/zextras/common/include ${CPPFLAGS}"
  export PKG_CONFIG_PATH="/opt/zextras/common/lib/pkgconfig:/opt/zextras/common/lib64/pkgconfig"

  _host_flag=""
  _build_flag=""
  if [ -n "${CROSS_COMPILE}" ]; then
    export CC="${CROSS_COMPILE}gcc"
    export CXX="${CROSS_COMPILE}g++"
    export AR="${CROSS_COMPILE}ar"
    export RANLIB="${CROSS_COMPILE}ranlib"
    _host_flag="--host=${CROSS_COMPILE_HOST}"
    _build_flag="--build=$(gcc -dumpmachine)"
    # Target-arch pkg-config dirs for the cross sysroot, plus carbonio libs.
    export PKG_CONFIG_LIBDIR="/opt/zextras/common/lib/pkgconfig:/opt/zextras/common/lib64/pkgconfig:/usr/lib/${CROSS_COMPILE_HOST}/pkgconfig:/usr/share/pkgconfig"
    unset PKG_CONFIG_PATH
  else
    export CC=clang
    export CXX=clang++
  fi

  bash ./autogen.sh --libdir=/opt/zextras/docs \
    --prefix=/opt/zextras/docs \
    ${_host_flag} ${_build_flag} \
    --enable-release-build \
    --enable-eot \
    --enable-extension-integration \
    --with-product-name=core \
    --with-vendor=zextras \
    --with-system-dicts \
    --with-myspell-dicts \
    --with-system-zlib \
    --without-helppack-integration \
    --without-package-format \
    --without-system-cairo \
    --without-system-harfbuzz \
    --with-system-openssl \
    --without-system-libpng \
    --with-system-libxml \
    --without-system-jpeg \
    --without-system-expat \
    --without-system-boost \
    --with-system-curl \
    --with-system-icu \
    --without-system-nss \
    --without-system-jars \
    --without-system-poppler \
    --without-system-postgresql \
    --without-java \
    --without-junit \
    --without-help \
    --with-linker-hash-style=both \
    --with-fonts \
    --enable-noto-font \
    --with-galleries=no \
    --with-theme=colibre_svg \
    --disable-dbus \
    --disable-odk \
    --disable-kf5 \
    --disable-gtk3 \
    --disable-qt5 \
    --disable-gstreamer-1-0 \
    --disable-evolution2 \
    --disable-gio \
    --disable-gui \
    --disable-scripting-beanshell \
    --disable-scripting-javascript \
    --disable-ext-wiki-publisher \
    --disable-report-builder \
    --disable-ext-nlpsolver \
    --disable-sdremote \
    --disable-sdremote-bluetooth \
    --disable-postgresql-sdbc \
    --disable-firebird-sdbc \
    --disable-randr \
    --enable-epm \
    --enable-python=system \
    --disable-online-update \
    --disable-dconf \
    --enable-mergelibs \
    --enable-ccache \
    --with-lang=ALL \
    --disable-lotuswordpro \
    --disable-lpsolve \
    --disable-symbols \
    --disable-coinmp \
    --disable-debug \
    --disable-extension-update

  echo "lo_sources_ver=${pkgver}" >sources.ver
  make build -j"$(nproc)"
}

package() {
  cd "${srcdir}/core-cp-${pkgver}-${_pkgrel}"

  install -dm755 "${pkgdir}/opt/zextras/docs/core"
  cp -r instdir/* "${pkgdir}"/opt/zextras/docs/core

  # make pyuno find its modules
  install -dm755 "${pkgdir}"/opt/zextras/common/lib/python3.8/site-packages
  ln -svf /opt/zextras/docs/core/program/uno.py \
    "${pkgdir}"/opt/zextras/common/lib/python3.8/site-packages/uno.py
  ln -svf /opt/zextras/docs/core/program/unohelper.py \
    "${pkgdir}"/opt/zextras/common/lib/python3.8/site-packages/unohelper.py

  # add headers
  install -dm755 "${pkgdir}"/opt/zextras/common/include/LibreOfficeKit
  install -v -m644 include/LibreOfficeKit/* \
    "${pkgdir}"/opt/zextras/common/include/LibreOfficeKit

  rm "${pkgdir}"/opt/zextras/docs/core/EULA*
}
