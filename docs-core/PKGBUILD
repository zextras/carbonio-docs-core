  "https://github.com/LibreOffice/core/archive/cp-${pkgver}-1.tar.gz"
  "openoffice.lst.in.append"
  "zextras-core.patch"
)
hashsums=(
  "skip"
  "98f41a0f9cda7bfbee46dfb78fcc12331404276f4bdf7763e090dd9b0d524076"
