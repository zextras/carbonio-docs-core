# This package is provided only by a 3rd-party repo (OKey) on
# RHEL8 (on non-enterprise ones is directly available)
# Please have a look at:
# https://git.rockylinux.org/staging/rpms/libepoxy/-/blob/r8/SPECS/libepoxy.spec
pkgname="libepoxy"
pkgver="1.5.10" # renovate: datasource=github-tags depName=anholt/libepoxy extractVersion=^v?(?<version>.+)$
pkgrel="1"
pkgdesc="epoxy runtime library"
license=("MIT")
maintainer="Zextras <packages@zextras.com>"
url="https://zextras.com"
section="Unspecified"
arch=('x86_64')
makedepends=(
  "gcc"
  "libglvnd-devel"
  "libX11-devel"
  "mesa-dri-drivers"
  "meson"
  "python3"
  "xorg-x11-server-Xvfb"
)

source=(
  "https://github.com/anholt/libepoxy/archive/refs/tags/${pkgver}.tar.gz"
)
sha256sums=(
  'a7ced37f4102b745ac86d6a70a9da399cc139ff168ba6b8002b4d8d43c900c15'
)

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  meson builddir --prefix=/usr
  meson compile -C builddir
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" meson install -C builddir

  rm -rf "${pkgdir}/usr/include"
  rm -rf "${pkgdir}/usr/lib64/pkgconfig"
}
